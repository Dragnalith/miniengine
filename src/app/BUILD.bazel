load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")
load("//build/rules:windows_app.bzl", "windows_app")
load("//build/rules/android:apk.bzl", "android_apk")
load("//build/rules/android:emulator.bzl", "android_emulator")

cc_library(
    name = "app_lib",
    srcs = glob([
        "src/**/*.cpp",
        "include/app/*.h",
    ]),
    includes = ["include"],
    alwayslink = True,
    deps = [
        "//src/foundation",
        "//src/framework",
    ],
)

# Desktop (Windows) executable + bundle.
cc_binary(
    name = "app_binary",
    deps = [":app_lib"],
)

windows_app(
    name = "app_windows",
    assets = "//src/framework:assets",
    binary = ":app_binary",
)

# The Dear ImGui UI renders through the bindless Vulkan RHI, which needs a
# capable Vulkan device, so the emulator runs on the host GPU (gfxstream).
android_emulator(
    name = "emulator",
    gpu = "host",
)

# Android APK. The packaged native library is lib<name>.so, so the target name
# must match android.app.lib_name in AndroidManifest.xml ("app_apk"). The Dear
# ImGui shaders are compiled to SPIR-V (the APK build pins gpuapi=Vulkan) and
# bundled as assets, loaded at runtime through the AAssetManager.
android_apk(
    name = "app_apk",
    custom_package = "com.example.app",
    default_emulator = ":emulator",
    manifest = "AndroidManifest.xml",
    assets = [
        "//src/framework:dear_imgui_pixel",
        "//src/framework:dear_imgui_vertex",
    ],
    deps = [":app_lib"],
)

# Platform-dispatching entry point:
#   bazel run //src/app                         (desktop bundle)
#   bazel run //src/app --platforms=//:android  (Android APK)
alias(
    name = "app",
    actual = select({
        "@platforms//os:android": ":app_apk",
        "//conditions:default": ":app_windows",
    }),
    visibility = ["//visibility:public"],
)
